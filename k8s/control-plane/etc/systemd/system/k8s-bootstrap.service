# systemd is PID 1 in the node container and runs containerd and kubelet as
# units, so the first-boot bootstrap is a unit too: it orders itself after
# containerd, logs to the journal, and ConditionPathExists makes it a no-op
# on every later boot once kubelet is configured.
[Unit]
Description=hpc-lab kubeadm bootstrap (first boot only)
After=containerd.service network-online.target
Wants=containerd.service network-online.target
ConditionPathExists=!/etc/kubernetes/kubelet.conf

[Service]
Type=oneshot
# k8s/.env.secrets.local (the bootstrap token), mounted by docker-compose.yaml.
EnvironmentFile=/etc/hpc-lab/k8s.secrets.env
ExecStart=/usr/local/bin/bootstrap.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
