# slurmdbd.conf of the simulated cluster: slurmdbd keeps the accounting in the
# MariaDB server of this container. Reference: https://slurm.schedmd.com/slurmdbd.conf.html
DbdHost=localhost

# Run as root, like the controller (slurm.conf), without authentication.
SlurmUser=root
AuthType=auth/none

# Files of a simulation, next to the controller's.
PidFile=<%= @sim_home %>/var/slurmdbd.pid
LogFile=<%= @sim_home %>/log/slurmdbd.log

# The MariaDB server and the user its init file creates (/etc/mysql/hpc-lab-init.sql).
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass=slurm
# Database of the accounting; slurm-simulate drops it before each simulation.
StorageLoc=slurm_acct_db
