#!/usr/bin/env bash
# Run a command on a Slurm node. The head node (slurmctld) is the default:
#   slurm-exec sinfo                       head node
#   slurm-exec head sinfo                  head node
#   slurm-exec login squeue                login node
#   slurm-exec compute cpu-0 hostname      compute node (slurmd) cpu-0
. /usr/local/lib/hpc-lab.sh
case "${1:-}" in
  head)    shift; selector='app.kubernetes.io/name=slurmctld'; container=slurmctld ;;
  login)   shift; selector='app.kubernetes.io/name=login'; container=login ;;
  compute) shift; node=${1:?usage: slurm-exec compute NODE [cmd...]}; shift
           selector='app.kubernetes.io/name=slurmd'; container=slurmd ;;
  *)       selector='app.kubernetes.io/name=slurmctld'; container=slurmctld ;;
esac
jsonpath='{.items[0].metadata.name}'
[ -n "${node:-}" ] && jsonpath="{.items[?(@.spec.hostname==\"${node}\")].metadata.name}"
pod=$(kubectl -n slurm get pods -l "$selector" --field-selector=status.phase=Running -o jsonpath="$jsonpath" 2>/dev/null)
[ -n "$pod" ] || fail "no running ${container} pod${node:+ for node $node} in namespace slurm (is the Slurm layer started?)"
tty_flag=""; [ -t 0 ] && [ -t 1 ] && tty_flag="-t"
exec kubectl -n slurm exec -i $tty_flag "$pod" -c "$container" -- "${@:-bash}"
